# 敏感配置
.env

# 派生数据：不进 git，由 GitHub Actions 在服务器上定时生成，本地也会自动重建。
#   data/    行情缓存 data/{code}_daily.json —— 回测/信号运行时按需拉取并写盘
#   output/  回测与信号结果 —— 部署页面时现场生成
# 二者都是「可再生」的派生产物，提交它们会与 CI 反复互相覆盖、产生 git 冲突。
data/
output/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 部署时组装的静态站点（CI 中为临时产物）
_site/

# 临时文件
*.tmp
freeze_tmp.txt
.DS_Store
Thumbs.db

# 本地工作区记忆（不提交）
.workbuddy/
